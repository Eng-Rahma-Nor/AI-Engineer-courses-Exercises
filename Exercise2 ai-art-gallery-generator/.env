# Copy this file to .env and fill in whichever keys you have.
# Any provider whose key is missing automatically runs in MOCK MODE
# (it produces a clearly-labeled placeholder image instead of a real
# API call), so the app always runs end-to-end even with zero keys.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# https://fal.ai/dashboard/keys
FAL_KEY=

# Optional: override the Replicate model version used for generation
# (defaults to a current SDXL version baked into the code)
REPLICATE_MODEL=stability-ai/sdxl

# Optional: override the fal.ai model endpoint
FAL_MODEL=fal-ai/flux/dev
